# Safe local defaults. Copy only machine-specific overrides to .envrc.local.
export BQEMU_CONFIG="${BQEMU_CONFIG:-$PWD/configs/bqemu.yaml}"
export BQEMU_DATABASE_DSN="${BQEMU_DATABASE_DSN:-$PWD/data/bqemu.duckdb}"
export BQEMU_TEMP_DIRECTORY="${BQEMU_TEMP_DIRECTORY:-${TMPDIR:-/tmp}/bqemu}"
export BQEMU_GO_TEST_TIMEOUT="${BQEMU_GO_TEST_TIMEOUT:-10m}"
export BQEMU_PYTEST_TIMEOUT_SECONDS="${BQEMU_PYTEST_TIMEOUT_SECONDS:-300}"
export BQEMU_BQCLI_TIMEOUT_SECONDS="${BQEMU_BQCLI_TIMEOUT_SECONDS:-300}"
export BQEMU_DOCKER_START_TIMEOUT_SECONDS="${BQEMU_DOCKER_START_TIMEOUT_SECONDS:-120}"
export BQEMU_SPARK_TEST_TIMEOUT_SECONDS="${BQEMU_SPARK_TEST_TIMEOUT_SECONDS:-600}"
export BQEMU_SPARK_RPC_TIMEOUT_SECONDS="${BQEMU_SPARK_RPC_TIMEOUT_SECONDS:-30}"
export BQEMU_ARTIFACT_TIMEOUT_SECONDS="${BQEMU_ARTIFACT_TIMEOUT_SECONDS:-180}"
