{
  "schemaVersion": "1",
  "id": "spark-bigquery-connector-dsv2-raw-0.44.2",
  "consumers": [
    {
      "kind": "connector-artifact",
      "name": "spark-3.5-bigquery-raw",
      "versions": ["0.44.2"]
    }
  ],
  "description": "Source-derived DSv2 protocol profile for the unmodified spark-3.5-bigquery:0.44.2 artifact. Exact Structured Streaming finalizes PENDING streams but its driver hook does not batch commit them.",
  "sources": [
    "https://github.com/GoogleCloudDataproc/spark-bigquery-connector/blob/719817782a214b8ca72be520870013a3e0253d92/spark-bigquery-dsv2/spark-3.1-bigquery-lib/src/main/java/com/google/cloud/spark/bigquery/v2/BigQueryStreamingWrite.java",
    "https://github.com/GoogleCloudDataproc/spark-bigquery-connector/blob/719817782a214b8ca72be520870013a3e0253d92/spark-bigquery-connector-common/src/main/java/com/google/cloud/spark/bigquery/write/context/DataSourceWriterContext.java",
    "https://github.com/GoogleCloudDataproc/spark-bigquery-connector/blob/719817782a214b8ca72be520870013a3e0253d92/spark-bigquery-connector-common/src/main/java/com/google/cloud/spark/bigquery/write/context/BigQueryDirectDataSourceWriterContext.java",
    "https://github.com/GoogleCloudDataproc/spark-bigquery-connector/blob/719817782a214b8ca72be520870013a3e0253d92/bigquery-connector-common/src/main/java/com/google/cloud/bigquery/connector/common/BigQueryDirectDataWriterHelper.java",
    "https://repo.maven.apache.org/maven2/com/google/cloud/spark/spark-3.5-bigquery/0.44.2/spark-3.5-bigquery-0.44.2.jar",
    "https://repo.maven.apache.org/maven2/com/google/cloud/spark/spark-3.5-bigquery/0.44.2/spark-3.5-bigquery-0.44.2.pom",
    "https://repo.maven.apache.org/maven2/com/google/cloud/google-cloud-bigquerystorage/3.22.1/google-cloud-bigquerystorage-3.22.1-sources.jar",
    "https://cloud.google.com/bigquery/docs/write-api#pending_type"
  ],
  "capabilities": {
    "grpc.storage_write": "partial",
    "dsv2.streaming.exact.commit": "planned",
    "dsv2.streaming.at_least_once": "planned"
  },
  "flows": {
    "dsv2-direct-exact-streaming-raw": [
      {
        "stage": "destination_metadata",
        "protocol": "REST",
        "method": "GET",
        "target": "/bigquery/v2/projects/{project}/datasets/{dataset}/tables/{table}",
        "requiredFields": ["response.tableReference", "response.schema.fields"]
      },
      {
        "stage": "create_pending_stream",
        "protocol": "gRPC",
        "method": "UNARY",
        "target": "/google.cloud.bigquery.storage.v1.BigQueryWrite/CreateWriteStream",
        "requiredFields": ["request.parent", "request.write_stream.type", "response.name"]
      },
      {
        "stage": "get_pending_stream",
        "protocol": "gRPC",
        "method": "UNARY",
        "target": "/google.cloud.bigquery.storage.v1.BigQueryWrite/GetWriteStream",
        "requiredFields": ["request.name", "request.view", "response.name", "response.location"]
      },
      {
        "stage": "append_rows",
        "protocol": "gRPC",
        "method": "BIDI_STREAM",
        "target": "/google.cloud.bigquery.storage.v1.BigQueryWrite/AppendRows",
        "requiredFields": ["request.first.write_stream", "request.first.offset", "request.first.proto_rows.writer_schema", "request.first.proto_rows.rows", "request.continuation.write_stream", "request.continuation.proto_rows.writer_schema", "response.append_result.offset"]
      },
      {
        "stage": "finalize_stream",
        "protocol": "gRPC",
        "method": "UNARY",
        "target": "/google.cloud.bigquery.storage.v1.BigQueryWrite/FinalizeWriteStream",
        "requiredFields": ["request.name", "response.row_count"]
      }
    ]
  }
}
