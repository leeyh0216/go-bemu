{
  "profileId": "google-cloud-bigquery-python-3.43.0",
  "consumerKind": "client",
  "consumerName": "google-cloud-bigquery-python",
  "consumerVersion": "3.43.0",
  "fixtureKind": "source-derived",
  "sourceRefs": [
    "https://pypi.org/project/google-cloud-bigquery/3.43.0/",
    "https://cloud.google.com/bigquery/docs/reference/rest/v2/jobs/insert",
    "https://cloud.google.com/bigquery/docs/reference/rest/v2/Job#JobConfigurationQuery",
    "https://cloud.google.com/bigquery/docs/reference/rest/v2/jobs/getQueryResults"
  ],
  "flow": "python-query-destination-lifecycle",
  "events": [
    {
      "stage": "insert_destination_query_job",
      "protocol": "REST",
      "method": "POST",
      "target": "/bigquery/v2/projects/{project}/jobs",
      "fields": {
        "request.jobReference.location": "US",
        "request.configuration.query.destinationTable": "project.dataset.table",
        "request.configuration.query.writeDisposition": "WRITE_EMPTY_or_WRITE_APPEND_or_WRITE_TRUNCATE",
        "request.configuration.query.createDisposition": "CREATE_IF_NEEDED",
        "response.status.state": "PENDING_or_RUNNING_or_DONE"
      }
    },
    {
      "stage": "reject_duplicate_query_job",
      "protocol": "REST",
      "method": "POST",
      "target": "/bigquery/v2/projects/{project}/jobs",
      "fields": {
        "request.jobReference.jobId": "same_fixed_job_id",
        "response.error.code": 409,
        "response.error.errors.reason": "duplicate"
      }
    },
    {
      "stage": "get_location_scoped_job",
      "protocol": "REST",
      "method": "GET",
      "target": "/bigquery/v2/projects/{project}/jobs/{job}",
      "fields": {
        "request.location": "US",
        "response.jobReference.location": "US",
        "response.configuration.query.writeDisposition": "round_trip"
      }
    },
    {
      "stage": "poll_destination_query_results",
      "protocol": "REST",
      "method": "GET",
      "target": "/bigquery/v2/projects/{project}/queries/{job}",
      "fields": {
        "request.location": "US",
        "request.maxResults": 1,
        "response.jobComplete": true
      }
    }
  ]
}
