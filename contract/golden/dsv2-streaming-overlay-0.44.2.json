{
  "profileId": "spark-bigquery-connector-dsv2-overlay-0.44.2",
  "consumerKind": "connector-artifact",
  "consumerName": "spark-3.5-bigquery-streaming-visibility-overlay",
  "consumerVersion": "0.44.2",
  "fixtureKind": "source-derived",
  "sourceRefs": [
    "https://github.com/GoogleCloudDataproc/spark-bigquery-connector/blob/719817782a214b8ca72be520870013a3e0253d92/spark-bigquery-dsv2/spark-3.1-bigquery-lib/src/main/java/com/google/cloud/spark/bigquery/v2/BigQueryStreamingWrite.java#L23-L41",
    "https://github.com/GoogleCloudDataproc/spark-bigquery-connector/blob/719817782a214b8ca72be520870013a3e0253d92/spark-bigquery-connector-common/src/main/java/com/google/cloud/spark/bigquery/write/context/BigQueryDirectDataSourceWriterContext.java#L199-L312",
    "https://spark.apache.org/docs/3.5.8/api/java/org/apache/spark/sql/connector/write/streaming/StreamingWrite.html",
    "https://cloud.google.com/bigquery/docs/reference/storage/rpc/google.cloud.bigquery.storage.v1#google.cloud.bigquery.storage.v1.BigQueryWrite.BatchCommitWriteStreams"
  ],
  "flow": "dsv2-direct-streaming-overlay-normal-path",
  "events": [
    {
      "stage": "destination_metadata",
      "protocol": "REST",
      "method": "GET",
      "target": "/bigquery/v2/projects/{project}/datasets/{dataset}/tables/{table}",
      "fields": {"response.tableReference": true, "response.schema.fields": true}
    },
    {
      "stage": "create_pending_stream",
      "protocol": "gRPC",
      "method": "UNARY",
      "target": "/google.cloud.bigquery.storage.v1.BigQueryWrite/CreateWriteStream",
      "fields": {"request.parent": true, "request.write_stream.type": "PENDING", "response.name": true}
    },
    {
      "stage": "append_rows",
      "protocol": "gRPC",
      "method": "BIDI_STREAM",
      "target": "/google.cloud.bigquery.storage.v1.BigQueryWrite/AppendRows",
      "fields": {"request.first.write_stream": true, "request.first.offset": "monotonic-starting-at-zero", "request.first.proto_rows.writer_schema": true, "request.first.proto_rows.rows": true, "request.continuation.write_stream": "omitted-on-same-bidi-connection", "request.continuation.proto_rows.writer_schema": "omitted-on-same-schema", "response.append_result.offset": true}
    },
    {
      "stage": "finalize_stream",
      "protocol": "gRPC",
      "method": "UNARY",
      "target": "/google.cloud.bigquery.storage.v1.BigQueryWrite/FinalizeWriteStream",
      "fields": {"request.name": true, "response.row_count": true}
    },
    {
      "stage": "batch_commit_epoch",
      "protocol": "gRPC",
      "method": "UNARY",
      "target": "/google.cloud.bigquery.storage.v1.BigQueryWrite/BatchCommitWriteStreams",
      "fields": {"request.parent": true, "request.write_streams": "one-epoch-stream-set", "response.commit_time": true}
    }
  ]
}
